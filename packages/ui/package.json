{
  "name": "kemet-ui",
  "version": "4.1.0",
  "description": "A flexible blueprint system for UIs.",
  "watch": {
    "build": "src/**/*.*",
    "analyze": "src/elements/*.ts",
    "pack": "src/**/*.*"
  },
  "type": "module",
  "scripts": {
    "analyze": "custom-elements-manifest analyze --litelement --globs \"src/elements/**/*\"",
    "build": "rimraf dist && npm run build:css && npm run build:ts",
    "build:css": "sass --load-path=node_modules src/styles/kemet.tokens.scss:dist/styles/kemet.tokens.css && postcss dist/styles/**/*.css -u autoprefixer --dir dist/styles",
    "build:litcss": "node scripts/build-litcss.js",
    "build:ts": "node --max-old-space-size=8192 node_modules/.bin/tsup",
    "dev": "npm-watch",
    "format:eslint": "eslint --ext .js,.html . --fix --ignore-pattern .gitignore",
    "format:stylelint": "npx stylelint --fix 'src/styles/**/*.scss' -c stylelint.config.mjs",
    "lint:eslint": "eslint --ext .js,.html . --ignore-pattern .gitignore",
    "lint:stylelint": "npx stylelint 'src/styles/**/*.scss' -c stylelint.config.mjs",
    "pack": "npm run build && npm pack --pack-destination ../published",
    "prepublish": "rimraf dist && npm run build",
    "test": "vitest --config=vitest.browser.config.mts",
    "preversion": "npm run build"
  },
  "author": {
    "name": "Hasani Rogers",
    "email": "contact@deificarts.com"
  },
  "license": "MIT",
  "keywords": [
    "web components",
    "custom elements",
    "design system"
  ],
  "exports": {
    "./elements/*": "./dist/elements/*",
    "./types/jsx": "./types/jsx.d.ts",
    "./types/solid": "./types/solid.d.ts",
    "./react": "./dist/wrappers/react.js",
    "./styles/*": "./dist/styles/*",
    "./custom-elements.json": "./custom-elements.json"
  },
  "files": [
    "dist",
    "types",
    "custom-elements.json"
  ],
  "browserslist": [
    "last 2 versions",
    "iOS >= 8"
  ],
  "dependencies": {
    "@lit/react": "^1.0.8",
    "autoprefixer": "^10.5.4",
    "kemet-tokens": "*",
    "lit": "^3.3.3",
    "mobile-drag-drop": "2.2.0",
    "typewriter-effect": "^2.22.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^4.1.11",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-lit-a11y": "^5.1.1",
    "eslint-plugin-wc": "^3.1.0",
    "npm-watch": "^0.13.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rimraf": "^6.1.3",
    "sass": "^1.103.1",
    "stylelint": "^17.14.1",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-config-standard": "^40.0.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-browser-lit": "^1.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasanirogers/kemet.git"
  },
  "bugs": {
    "url": "https://github.com/hasanirogers/kemet/issues"
  },
  "homepage": "https://kemet.dev",
  "customElements": "custom-elements.json"
}
