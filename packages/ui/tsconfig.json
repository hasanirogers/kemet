{
  "extends": ["@kemet/typescript-config/lit"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "./.storybook/**/*.ts", "./.storybook/**/*.tsx", "types/global.d.ts", "types/jsx.d.ts", "types/typewriter-effect.d.ts", "types/vite-env.d.ts"],
  "exclude": ["node_modules", "sandboxes", "./src/stories/**/*"]
}
