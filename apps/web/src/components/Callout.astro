---
const { appearance = "warning" } = Astro.props;
---

<div class="callout" data-appearance={appearance}>
  <slot />
</div>

<script>
  import '../../../../packages/tokens/dist/css/tokens.css';
</script>

<style>
  .callout {
    display: flex;
    align-items: center;
    padding: 1rem 1.5rem;
    border-radius: 0.5rem;
    margin: 1rem 0 2rem 0;
    font-size: 1.1rem;

    code {
      position: relative;
      top: 2px;
      margin: 0 0.25rem;
      padding: 0.25rem 0.5rem;
      background: transparent;
      border: 1px dotted;
      /* backdrop-filter: invert(1) opacity(0.66); */
    }

    a {
      color: white;
      font-weight: bold;
    }

    &[data-appearance="warning"] {
      color: var(--kemet-color-font-inverse-base);
      background-color: var(--kemet-color-base-orange-800);
    }

    &[data-appearance="info"] {
      color: var(--kemet-color-font-inverse-base);
      background-color: var(--kemet-color-base-blue-800);
    }
  }

  .callout
</style>
