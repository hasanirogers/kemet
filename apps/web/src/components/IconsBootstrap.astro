---
// Fetch Bootstrap icons from the official GitHub repository
const response = await fetch('https://raw.githubusercontent.com/twbs/icons/main/font/bootstrap-icons.json');
const iconData = await response.json();
const iconNames = Object.keys(iconData)
  .filter((iconName) => !/^\d/.test(iconName)) // Filter out icons starting with numbers
  .sort();
---

<div class="icons-container">
  <div class="search-bar">
    <input
      type="text"
      id="icon-search"
      placeholder="Search icons..."
      class="search-input"
    />
    <div class="search-stats">
      <span id="icon-count">{iconNames.length}</span> icons
    </div>
  </div>

  <div class="icons-grid" id="icons-grid">
    {iconNames.map((iconName) => (
      <div class="icon-item" data-icon-name={iconName.toLowerCase()}>
        <kemet-icon
          name={iconName}
          library="bootstrap"
          size={32}
        ></kemet-icon>
        <span class="icon-name">{iconName}</span>
      </div>
    ))}
  </div>
</div>

<script>
  import '../../../../packages/tokens/dist/css/tokens.css';
  import '../../../../packages/ui/src/elements/icon/index.js';

  // Search functionality
  const searchInput = document.getElementById('icon-search') as HTMLInputElement;
  const iconsGrid = document.getElementById('icons-grid');
  const iconCount = document.getElementById('icon-count');
  const iconItems = document.querySelectorAll('.icon-item');

  searchInput?.addEventListener('input', (e) => {
    const target = e.target as HTMLInputElement;
    const searchTerm = target.value.toLowerCase();
    let visibleCount = 0;

    iconItems.forEach((item) => {
      const iconItem = item as HTMLElement;
      const iconName = iconItem.dataset.iconName || '';
      const isVisible = iconName.includes(searchTerm);

      if (isVisible) {
        iconItem.style.display = 'flex';
        visibleCount++;
      } else {
        iconItem.style.display = 'none';
      }
    });

    if (iconCount) {
      iconCount.textContent = visibleCount.toString();
    }
  });
</script>

<style>
  .icons-container {
    width: 100%;
  }

  .search-bar {
    display: flex;
    flex-direction: column;
    width: 100%;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    background: var(--kemet-color-base-gray-50);
    border: 1px solid;
    border-radius: 0.5rem;
  }

  .search-input {
    flex: 1;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 1px solid;
    border-radius: 0.375rem;
    background: white;
    color: var(--kemet-color-font-base);
    outline: none;
    transition: border-color 0.2s ease;
  }

  .search-input:focus {
    border-color: var(--kemet-color-base-blue-500);
  }

  .search-input::placeholder {
    color: var(--kemet-color-font-muted);
  }

  .search-stats {
    font-size: 0.875rem;
    color: var(--kemet-color-font-muted);
    white-space: nowrap;
  }

  .icons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 1.5rem;
    padding: 2rem 0;
  }

  .icon-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 1rem;
    border: 1px solid;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .icon-item:hover {
    transform: translateY(-2px);
  }

  .icon-item kemet-icon {
    margin-bottom: 0.5rem;
  }

  .icon-name {
    font-size: 0.75rem;
    text-align: center;
    color: inherit;
    word-break: break-word;
    font-family: monospace;
  }
</style>
