---
import hljs from 'highlight.js';
import customElements from '../../../../packages/ui/custom-elements.json';
import extractJSDocTags from '../utilities/extractJSDocTags.js';
import CodePreview from './CodePreview.astro';

import 'highlight.js/styles/github-dark.css';

interface Props {
  element: string;
  sample: string;
}

const { element, sample } = Astro.props;

const tagname = `kemet-${element}`;

const allTags = customElements.modules.map((elementData) => {
  return extractJSDocTags(elementData.path);
});

function getElementTags(allTags: any[], tagname: string) {
  return allTags.find((tag) => tag[0]?.tags?.tagname === tagname);
}

const tags = getElementTags(allTags, tagname)?.[0]?.tags;

const importCode = `import '@kemet-ui/elements/${element}';`;
const importHTML = hljs.highlight(importCode, { language: 'javascript' }).value
---

<div class="view-on">
  <small>View on:&nbsp;</small>
  <span class="view-on-icons">
    <a href={`https://github.com/hasanirogers/kemet/tree/main/packages/ui/src/elements/${element}`} target="_blank">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 640 640" fill="currentColor"><path d="M280.5 426.5C214.5 418.5 168 371 168 309.5C168 284.5 177 257.5 192 239.5C185.5 223 186.5 188 194 173.5C214 171 241 181.5 257 196C276 190 296 187 320.5 187C345 187 365 190 383 195.5C398.5 181.5 426 171 446 173.5C453 187 454 222 447.5 239C463.5 258 472 283.5 472 309.5C472 371 425.5 417.5 358.5 426C375.5 437 387 461 387 488.5L387 540.5C387 555.5 399.5 564 414.5 558C505 523.5 576 433 576 321C576 179.5 461 64 319.5 64C178 64 64 179.5 64 321C64 432 134.5 524 229.5 558.5C243 563.5 256 554.5 256 541L256 501C249 504 240 506 232 506C199 506 179.5 488 165.5 454.5C160 441 154 433 142.5 431.5C136.5 431 134.5 428.5 134.5 425.5C134.5 419.5 144.5 415 154.5 415C169 415 181.5 424 194.5 442.5C204.5 457 215 463.5 227.5 463.5C240 463.5 248 459 259.5 447.5C268 439 274.5 431.5 280.5 426.5z"/></svg>
    </a>
    <a href={`https://storybook.kemet.dev/?path=/story/elements-${element}--standard`}>
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 640 640" fill="currentColor"><path d="M106.5 99.1L123 538.1C123.5 552 134.6 563.2 148.5 563.8L505.5 579.8C505.9 579.8 506.3 579.8 506.7 579.8C521.5 579.8 533.4 567.8 533.4 553.1L533.4 74.7C533.4 74.1 533.4 73.6 533.3 73C532.4 58.3 519.7 47.1 504.9 48L475.5 49.8L477.6 111.2C477.7 113.4 476 115.2 473.8 115.3C472.9 115.3 471.9 115 471.2 114.4L451.6 99L428.2 116.7C426.4 118 423.9 117.7 422.6 115.9C422 115.2 421.8 114.3 421.8 113.3L424.3 53.1L131.6 71.4C117.1 72.3 106 84.6 106.5 99.1zM435.7 251.8C426.3 259.1 356.2 264.1 356.2 253.7C357.7 214 339.9 212.3 330 212.3C320.6 212.3 304.8 215.1 304.8 236.4C304.8 258.1 327.9 270.3 355 284.7C393.5 305.1 440.1 329.8 440.1 391.9C440.1 451.5 391.7 484.4 330 484.4C266.3 484.4 210.6 458.6 216.9 369.3C219.4 358.8 300.3 361.3 300.3 369.3C299.3 406.2 307.7 417 328.9 417C345.2 417 352.6 408 352.6 392.9C352.6 370 328.5 356.5 300.9 341C263.4 320 219.3 295.2 219.3 238.4C219.3 181.7 258.3 143.9 327.9 143.9C397.5 143.9 435.5 181.1 435.5 252z"/></svg>
    </a>
  </span>
</div>

<p>{tags.summary}</p>

<CodePreview code={sample} language="html" />

<h2>Import</h2>
<hr /><br />
<pre><code><Fragment set:html={importHTML} /></code></pre>

<style>
  .view-on {
    position: absolute;
    top: -6.5rem;
    right: 0;
  }

  .view-on,
  .view-on-icons {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--sl-color-text);
  }
</style>


