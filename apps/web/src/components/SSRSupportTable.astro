---
import customElements from '../../../../packages/ui/custom-elements.json';
import extractJSDocTags from '../utilities/extractJSDocTags.js';
---

<section>
  <table>
    <thead>
      <tr>
        <th>Element</th>
        <th>SSR Safe</th>
      </tr>
    </thead>
    <tbody>
    {
      customElements.modules
        .map((element) => ({
          element,
          tagsData: extractJSDocTags(element.path),
        }))
        .filter(({ tagsData }) => tagsData[0]?.tags?.tagname)
        .sort((a, b) => a.tagsData[0].tags.tagname.localeCompare(b.tagsData[0].tags.tagname))
        .map(({ element, tagsData }) => {
          // const title = (tagsData[0]?.className || '').replace(/([A-Z])/g, ' $1').replace('Kemet', '').trim();
          const tags = tagsData[0]?.tags || {};

          return (
            <tr>
              <td>{tags.tagname}</td>
              <td>{tags.ssrsafe == 'yes' ? '✅' : '❌'}</td>
            </tr>
          )
        })
    }
    </tbody>
  </table>
</section>

<style>
  table {
    margin-bottom: 4rem;
  }

  table,
  th:first-child {
    width: 100%;
  }

  th {
    white-space: nowrap;
  }

  td {
    padding: 1rem;
  }
</style>
