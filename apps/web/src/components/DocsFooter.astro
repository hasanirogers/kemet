  menu {
    display: flex;
    gap: 1rem;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;

    a {
      filter: brightness(1.5);
    }
  }

  svg {
    display: inline-flex;
  }

  small {
    margin: 0.5rem 0 0 0;
    padding: 0;
    display: flex;
