---
interface Props {
  code: string;
  language?: string;
}

const { code, language = 'html' } = Astro.props;
let slotContent = code;

if (!code) {
  slotContent = await Astro.slots.render('default');
}
---

<web-code language={language} code={slotContent}></web-code>

