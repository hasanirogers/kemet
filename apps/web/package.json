{
  "name": "@kemet/web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently \"npm run dev:astro\" \"npm run dev:ui\"",
    "dev:astro": "astro dev --host",
    "dev:ui": "cd ../../packages/ui && npm run watch:dev",
    "build": "astro build",
    "lint": "eslint --max-warnings 0",
