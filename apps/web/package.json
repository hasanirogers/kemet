    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.10",
    "@kemet/typescript-config": "*",
    "kemet-ui": "*",
    "astro": "^5.15.4",
    "highlight.js": "^11.11.1",
    "lit": "^3.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "sass-embedded": "^1.93.3"
  }
}
